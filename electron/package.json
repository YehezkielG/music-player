{
  "name": "music-player",
  "version": "1.0.0",
  "description": "Hello World!",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:next": "cd ../next && npm ci && npm run build",
    "dist": "npm run build:next && electron-builder --win"
  },
  "author": "Jane Doe",
  "license": "MIT",
  "devDependencies": {
    "electron": "23.1.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "music-metadata": "^7.12.4",
    "serve-handler": "^6.1.5",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "build": {
    "appId": "com.gotune.app",
    "productName": "GoTune",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md}",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "../next",
        "to": "next",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.next/cache/**"
        ]
      }
    ],
    "win": {
      "target": ["nsis", "zip"]
    }
  }
}
